{
  "id": "com.anosovvv.vidload-plugin-pr",
  "name": "VIDLOAD Plugin Pr",
  "version": "0.1.1",
  "manifestVersion": 5,
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://localhost"
      ]
    }
  },
  "entrypoints": [
    {
      "id": "vidload-panel",
      "type": "panel",
      "label": {
        "default": "VIDLOAD Plugin Pr"
      },
      "minimumSize": {
        "width": 360,
        "height": 520
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 650
      },
      "preferredFloatingSize": {
        "width": 460,
        "height": 700
      }
    }
  ]
}
